@model Githubhacktues12please.Models.DTOs.MultiplierDTO;

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Stillform</title>

    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/style.css" />
</head>

<body>

    <canvas id="bg"></canvas>

    <div class="wrapper">

        <div class="controls">

            <form asp-action="UpdateHz" asp-controller="Home" method="post">
                <div class="slider-block">
                    <div class="value" id="val">1</div>
                    <input asp-for="Multiplier" class="slider" id="slider" type="range" min="0" max="2" step="0.01" value="1" />
                </div>

                <button type="submit" class="action-button" id="changeBtn"><span>CHANGE</span></button>

                <button class="toggle" id="toggle" type="button"><span>OFF</span></button>
            </form>

        </div>

    </div>

    <div class="footer">Burgaskite Glarusi 2026© All rights reserved</div>

    <script src="~/js/script.js"></script>

</body>
</html>

               